        <source srcset="{{hero_img_dsk}}" media="(min-width:1025px)" />
        <img src="{{hero_img_mob}}" alt="hero panel image" />
    </picture>
    <div data-role="hero-cta" class="hero-card">
        <h2>{{hero_title}}</h2>
        <a href="{{action_uri}}">{{action_text}}</a>
    </div>
</section>